  "stranger_script": [
    [
      "0~10초",
      "닫힌 안전문 밖에 서 있음",
      "개13 안전문 반응. 직접 접촉으로 읽지 않음."
    ],
    [
      "10~12초",
      "안전문을 열고 입실",
      "실제 문 열림·입실 시각 기록"
    ],
    [
      "12~16초",
      "이름을 부르기 전에 정지선까지 접근",
      "개55. 회피·굳음·으르렁이면 선 이전에도 중단."
    ],
    [
      "16~20초",
      "정지선에서 이름 1회, 제자리 대기",
      "개15 부름 후 4초 반응"
    ],
    [
      "20~23초",
      "개가 자발적으로 손 닿는 곳에 있고 회피하지 않으면 최대 3초 접촉",
      "개51·52. 서서 옆으로 가슴·어깨를 만짐. 쫓아가 만지지 않음. 기존 접촉 꼬리 바45는 제외."
    ],
    [
      "23~25초",
      "접촉 종료 후 대기. 미접촉이면 20~25초 대기",
      "개53 접촉 경로. 미접촉을 접촉 반응 0점으로 넣지 않음."
    ],
    [
      "25~30초",
      "돌아서 문으로 퇴장, 추가 부름·손짓 없음",
      "개54. 실제 첫걸음~안전문 통과. 한 바퀴 돌기 없음."
    ]
