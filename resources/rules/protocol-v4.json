    "location": "3~6절 / 부록 A"
  },
  "segments": [
    {
      "segment": "entry",
      "label": "입장",
      "nominal_seconds": 30,
      "start_event": "개가 방 문턱을 넘음",
      "procedure": "방 문 → 비닐 바닥 → 물건 옆 5초 정지 → 의자. 목줄 고리가 풀리면 종료."
    },
    {
      "segment": "baseline",
      "label": "기준",
      "nominal_seconds": 20,
      "start_event": "목줄 고리가 풀림",
      "procedure": "보호자는 의자에서 동일 안내책자를 읽음. 분리 구간 전까지 20초."
    },
    {
      "segment": "alone",
      "label": "혼자",
      "nominal_seconds": 60,
      "start_event": "보호자 몸이 완전히 문 밖으로 나감",
      "procedure": "문 밖에서 보이지 않게 대기. 재회 문 열림으로 종료. 처음 10초와 이후 50초를 구별."
    },
    {
      "segment": "reunion",
      "label": "재회",
      "nominal_seconds": 30,
      "start_event": "보호자가 문을 엶",
      "procedure": "0~15초 의자로 이동·착석·대기. 15초 신호 후 이름 1회·접촉 기회. 30초 종료 신호."
    },
    {
      "segment": "ignore",
      "label": "무시",
      "nominal_seconds": 20,
      "start_event": "만지기를 멈춤",
      "procedure": "말·시선·접촉 없음. 이후 이름 1회와 S로 이동은 전환 기록."
    },
    {
      "segment": "walk",
      "label": "걷기",
      "nominal_seconds": 30,
      "start_event": "S에서 첫걸음",
      "procedure": "S→A, 정지 5초 → A→C, 정지 5초 → C→S, 정지 5초. 마지막 정지 끝이 종료."
    },
    {
      "segment": "stranger",
      "label": "낯선",
      "nominal_seconds": 30,
      "start_event": "착석 뒤 5초 대기 후 요원이 닫힌 안전문 밖에 섬",
      "procedure": "문 밖 대기 → 입실 → 정지선 접근 → 부름 → 접촉 또는 대기 → 같은 문으로 나감."
    },
    {
      "segment": "exit",
      "label": "퇴장",
      "nominal_seconds": 30,
      "start_event": "목줄 채운 뒤 첫걸음",
      "procedure": "물건 옆 5초 정지 → 바닥 → 방 문. 개가 문턱 밖으로 나가면 종료."
    }
  ],
